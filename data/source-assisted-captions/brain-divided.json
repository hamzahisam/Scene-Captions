      "start_s": 34.2,
      "end_s": 34.78,
      "text": "Ahh..."
    },
    {
      "cue_id": "brain-divided-dialogue-004",
      "start_s": 48.0,
      "end_s": 50.32,
      "text": "Hi...ahh... John?"
    },
    {
      "cue_id": "brain-divided-dialogue-005",
      "start_s": 52.22,
      "end_s": 53.3,
      "text": "Sorry I'm Late"
    },
    {
      "cue_id": "brain-divided-dialogue-006",
      "start_s": 53.8,
      "end_s": 54.92,
      "text": "Ahhh"
    },
    {
      "cue_id": "brain-divided-dialogue-007",
      "start_s": 60.12,
      "end_s": 62.52,
      "text": "Um..Hi... you mus...you must be Scarlet..."
    },
    {
      "cue_id": "brain-divided-dialogue-008",
      "start_s": 62.9,
      "end_s": 66.22,
      "text": "Yeah it's...Uh... Nice to meet you"
    },
    {
      "cue_id": "brain-divided-dialogue-009",
      "start_s": 71.22,
      "end_s": 73.38,
      "text": "The pleasure is all mine..."
    },
    {
      "cue_id": "brain-divided-dialogue-010",
      "start_s": 82.28,
      "end_s": 85.03999999999999,
      "text": "Oh! Ahh.. here...Ah..."
    },
    {
      "cue_id": "brain-divided-dialogue-011",
      "start_s": 85.36,
      "end_s": 86.4,
      "text": "Take a seat..."
    },
    {
      "cue_id": "brain-divided-dialogue-012",
      "start_s": 86.84,
      "end_s": 87.84,
      "text": "Yeah sure..."
    },
    {
      "cue_id": "brain-divided-dialogue-013",
      "start_s": 89.32,
      "end_s": 92.0,
      "text": "Yeah, I hope you're hungry cuz I already ordered our food..."
    },
    {
      "cue_id": "brain-divided-dialogue-014",
      "start_s": 92.3,
      "end_s": 94.3,
      "text": "Oh great I'm starving..."
    },
    {
      "cue_id": "brain-divided-dialogue-015",
      "start_s": 94.3,
      "end_s": 97.02000000000001,
      "text": "I got us something that's low in carbs and high in antioxidants..."
    },
    {
      "cue_id": "brain-divided-dialogue-016",
      "start_s": 97.18,
      "end_s": 98.46000000000001,
      "text": "So you won't get fat..."
    },
    {
      "cue_id": "brain-divided-dialogue-017",
      "start_s": 98.53999999999999,
      "end_s": 99.96000000000001,
      "text": "Excuse me?"
    },
    {
      "cue_id": "brain-divided-dialogue-018",
      "start_s": 104.02000000000001,
      "end_s": 106.25999999999999,
      "text": "Hmm...Looks like you don't have that problem..."
    },
